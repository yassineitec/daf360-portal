# ── DAF360 Portal — required environment variables ─────────────────────────────
# Copy to `.env` (gitignored) and fill in REAL values locally; set as real env
# vars in dev/docker/prod. NEVER commit real secrets — the values below are blanks.

# Azure AD OAuth2 (app registration client secret)
AZURE_CLIENT_SECRET=

# Shared HMAC secret for HS256 tokens — MUST match app.jwt-secret in rh-service
# (see HS256-removal plan; RS256 keys below are the primary token path)
JWT_SECRET=

# RS256 key pair (files are gitignored under keys/)
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
JWT_ACCESS_EXPIRY=3600
JWT_REFRESH_EXPIRY=604800

# Databases
DB_HOST=localhost
DB_PORT=1433
DB_USERNAME=
DB_PASSWORD=
RH_DB_URL=
RH_DB_USERNAME=
RH_DB_PASSWORD=

# Frontend
FRONTEND_URL=http://localhost:4200

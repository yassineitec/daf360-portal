# =====================================================================
# DAF360 — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git (it is already in .gitignore).
# =====================================================================

# ─── Azure AD ──────────────────────────────────────────────────────
# Your App Registration credentials from Azure portal
AZURE_CLIENT_ID=<your-azure-app-registration-client-id>
AZURE_CLIENT_SECRET=<your-azure-app-registration-client-secret>
AZURE_TENANT_ID=<your-azure-ad-tenant-id>

# ─── JWT ───────────────────────────────────────────────────────────
# Shared secret used by ALL services to sign/verify internal tokens.
# Generate a strong secret: openssl rand -base64 32
# Must be at least 32 characters (256 bits for HMAC-SHA256).
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32
JWT_EXPIRY_SECONDS=3600

# ─── SQL Server ────────────────────────────────────────────────────
# SA (system admin) password for the local SQL Server Docker container.
# Production: use Azure SQL Server connection strings instead.
SQL_SA_PASSWORD=YourStrong!Passw0rd

# ─── RabbitMQ ──────────────────────────────────────────────────────
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=daf360
RABBITMQ_PASS=daf360

# ─── Frontend URLs (Angular SPAs) ──────────────────────────────────
FRONTEND_URL=http://localhost:4200
RH_FRONTEND_URL=http://localhost:4201
BILLING_FRONTEND_URL=http://localhost:4202

# ─── Backend Service URLs ───────────────────────────────────────────
# Used by the Portal to redirect after login and for service config.
RH_APP_URL=http://localhost:8081
BILLING_APP_URL=http://localhost:8082

# ─── Email / SMTP (for HR notifications, billing reminders) ────────
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_USERNAME=noreply@yourcompany.com
MAIL_PASSWORD=<your-email-app-password>

# ─── File Storage ──────────────────────────────────────────────────
# Path where HR documents are stored on the container/host
STORAGE_PATH=/app/uploads
